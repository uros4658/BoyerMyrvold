# Ignore everything
*

# Except the include and src directories
!include/
!src/
!.gitignore
!,g6

# Only include .h and .cpp files in include and src directories
include/*
!include/**/*.h
!include/**/*.cpp
!testGraphs
!testGraphs/*
!testGraphs/non-planar.g6
!testGraphs/planar.g6

src/*
!src/**/*.h
!src/**/*.cpp

# Except CMakeLists.txt
!CMakeLists.txt